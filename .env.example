# Server-side only. Never prefix these with VITE_.
# The browser calls the /api routes. The dev server reads this file.
# Copy to .env.local and paste your own values there.

# OpenAI
OPENAI_API_KEY=

# EnsembleData
ENSEMBLEDATA_API_TOKEN=

