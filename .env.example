# Server-side only. Never prefix this with VITE_.
# The browser calls the /api routes. The Vite dev and preview servers
# read these values and call the provider. They are not bundled into client code.
OPENAI_API_KEY=
# Client strategist only (Responses API). Unset uses gpt-5.6-sol with high reasoning.
# OPENAI_MODEL=gpt-5.6-sol
# Cheaper tasks. Unset uses gpt-4o-mini. They do not follow OPENAI_MODEL.
# OPENAI_MODEL_ANALYSIS=gpt-4o-mini
# OPENAI_MODEL_PROFILE=gpt-4o-mini
# OPENAI_MODEL_CREATIVE=gpt-4o-mini
# Reserved for a future model extractor. Research today is local HTML.
# OPENAI_MODEL_RESEARCH=gpt-4o-mini
# OPENAI image model for territory frames, used when TERRITORY_IMAGE_PROVIDER=openai.
# TERRITORY_IMAGE_MODEL=dall-e-3
